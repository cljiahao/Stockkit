# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Reverse proxy trust — set to the number of trusted proxy hops (1 = ALB → App, 2 = ALB → Traefik → App); leave empty/unset when there is no proxy (headers not trusted), e.g. local dev
TRUST_PROXY=

# Supabase (find these in Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# publishable key — client-safe, respects RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key — server-only, bypasses RLS; never expose to the client
SUPABASE_SECRET_KEY=

# Database (if using Drizzle — added by templatecentral:add (database))
# DATABASE_URL=

# Google OAuth (read by the Supabase CLI when running `supabase start`, NOT by Next).
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect URI:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   prod:  https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Third-party API tokens
# API_KEY=

# merqo hub bearer secrets — gate GET /api/merqo/metrics, /vendor-status,
# /vendor-activity (MERQO_METRICS_SECRET) and POST /api/merqo/vendor-provision
# (MERQO_PROVISION_SECRET, deliberately a separate secret). Real values are
# set out-of-band via the Vercel/Supabase dashboard, not committed here.
MERQO_METRICS_SECRET=
MERQO_PROVISION_SECRET=
# New: stockkit's first kit -> merqo outbound HTTP call (every var above gates
# the opposite, inbound direction — merqo calling stockkit). Used by
# src/lib/legal-gate.ts and src/app/legal/accept/actions.ts to check/record a
# vendor's terms/privacy acceptance with merqo. MERQO_CUSTOMER_SECRET is sent
# as `Authorization: Bearer <value>` and must equal the value merqo's own
# MERQO_CUSTOMER_SECRET env var records (same shared secret qkit/loopkit/
# paykit use for this direction). Server-only; unset here fails the legal
# gate CLOSED — every signed-in vendor gets bounced to /legal/accept and the
# accept action throws — so set both for any environment where vendors sign
# in.
MERQO_BASE_URL=
MERQO_CUSTOMER_SECRET=
