# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Reverse proxy trust — set to the number of trusted proxy hops (1 = ALB → App, 2 = ALB → Traefik → App); leave empty/unset when there is no proxy (headers not trusted), e.g. local dev
TRUST_PROXY=

# Supabase (find these in Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# publishable key — client-safe, respects RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key — server-only, bypasses RLS; never expose to the client
SUPABASE_SECRET_KEY=

# Database (if using Drizzle — added by templatecentral:add (database))
# DATABASE_URL=

# Google OAuth (read by the Supabase CLI when running `supabase start`, NOT by Next).
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect URI:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   prod:  https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Third-party API tokens
# API_KEY=
